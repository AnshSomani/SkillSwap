# MongoDB Atlas connection string
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://youruser:yourpassword@cluster0.xxxxx.mongodb.net/skillswap?retryWrites=true&w=majority

# JWT secret — use a long random string (e.g. run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=your_super_secret_jwt_key_here

# Admin credentials (used to seed the admin account on first login)
ADMIN_EMAIL=admin@skillswap.com
ADMIN_PASSWORD=supersecretpassword

# Deployed frontend URL (used by CORS) — set this to your Vercel frontend URL
FRONTEND_URL=https://your-frontend.vercel.app

# Vercel sets this automatically in serverless environment
# VERCEL=1
